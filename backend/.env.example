# Server-side only. Never commit real credentials.
PORT=8080
APP_API_KEY=replace-with-long-random-server-secret
ALLOWED_ORIGIN=https://example.com
# IDs from public.vehicles, not device IMEIs
DEVICE_ALLOWLIST=1,2,3
# Existing PostgreSQL service used by Teltonika receiver
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gps_ecuador
PGUSER=gps_api_readonly
PGPASSWORD=replace-on-server
