# Server-side only. NEVER commit real values or expose these to a browser.
PORT=8080
TRACCAR_URL=https://traccar.example.com
TRACCAR_TOKEN=replace-with-restricted-server-side-token
APP_API_KEY=replace-with-long-random-secret
ALLOWED_ORIGIN=https://example.com
DEVICE_ALLOWLIST=1,2,3
# For a trusted internal network only, not recommended:
# ALLOW_INSECURE_TRACCAR=true
